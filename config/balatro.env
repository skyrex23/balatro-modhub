# ======================================================================================================================
# Default configuration of the Balatro Mod Hub
#
# Do not edit this file for personal tweaks, use config/balatro.local.env instead (it is not tracked by git)
# ======================================================================================================================

# Steam app id of Balatro
BALATRO_APP_ID="2379780"

# Launch options of Balatro in Steam. The Lovely Injector needs them to load the mod loader.
STEAM_LAUNCH_OPTIONS='WINEDLLOVERRIDES="winmm=n,b" %command%'

# Path of the Balatro game folder. Leave it empty to auto-detect it.
BALATRO_GAME_DIR=""

# Path of the Balatro save folder, the one that contains the Mods folder. Leave it empty to auto-detect it.
BALATRO_SAVE_DIR=""

# How the enabled mods are materialised inside the Balatro Mods folder:
#   symlink -> symlink to the mod folder of this repository (default, updates are picked up instantly)
#   copy    -> copy of the mod folder (use it when the game does not follow symlinks)
MOD_LINK_MODE="symlink"

# Initialize the submodules of the mods recursively. Only needed by mods that bundle other repositories.
SUBMODULE_INIT_RECURSIVE="false"
