# ======================================================================================================================
# Local configuration of the Balatro mods collection
#
# Copy this file to config/balatro.local.env and adjust the values you need. The local file is not tracked by git.
# ======================================================================================================================

# Path of the Balatro game folder (the one that contains Balatro.exe)
# BALATRO_GAME_DIR="$HOME/.steam/steam/steamapps/common/Balatro"

# Path of the Balatro save folder (the one that contains the Mods folder)
# BALATRO_SAVE_DIR="$HOME/.steam/steam/steamapps/compatdata/2379780/pfx/drive_c/users/steamuser/AppData/Roaming/Balatro"

# symlink or copy
# MOD_LINK_MODE="symlink"
